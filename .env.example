# Copy to .env:  cp .env.example .env
# Loaded automatically by jobspy_api (sidecar) and scrape_sg.py.

# --- Job boards (comma-separated) ---
# Portal integration excludes linkedin by default to avoid overlap with the LinkedIn adapter.
JOBSPY_SITE_NAMES=indeed,linkedin,glassdoor,google,bayt

# --- Location ---
JOBSPY_LOCATION=Singapore
JOBSPY_COUNTRY=singapore

# --- Scrape limits ---
# Jobs per site, per search term (boards cap around ~1000/search)
JOBSPY_RESULTS_WANTED=5
# Max job age in hours (504 = last 3 weeks / 21 days)
JOBSPY_HOURS_OLD=504

# --- API sidecar ---
JOBSPY_PORT=8001

# --- Search terms (JSON array; use null for location-only sweep) ---
# Broad sweep: location-only plus generic role/industry terms (not tech-specific)
JOBSPY_SEARCH_TERMS=[null,"full time","part time","manager","executive","analyst","administrator","assistant","sales","marketing","finance","accounting","human resources","operations","customer service","engineer","technician","consultant","specialist","coordinator","intern","graduate","healthcare","education","retail","logistics","hospitality","legal","design"]
